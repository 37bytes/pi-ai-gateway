#!/usr/bin/env bash
# Launch OMP on the AGP TEST environment.
#
#   omp-test                     # new session on test
#   omp-test --resume <id>       # a session already bound to test keeps test
#   omp-test -p "ask something"  # headless run: providers come from test's cache
#
# Test reaches real models through its own restricted prod inference key held in
# the test profile's config; no production credential is copied or passed on the
# command line. Switching an existing conversation needs /cliproxy-profile, not
# a different launcher, so history never moves environments silently.

set -euo pipefail

profile="test"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/omp-profile-launch.sh"

launch_profile "$profile" "$@"
