{
	"name": "pi-ai-gateway",
	"version": "0.4.3",
	"type": "module",
	"description": "AI Gateway extension for Pi model discovery, routing, and quota visibility",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/37bytes/pi-ai-gateway.git"
	},
	"files": [
		"index.ts",
		"src",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./"
		]
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"ai-gateway"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"check:migration": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/check-config-migration.ts",
		"check:contract": "node --disable-warning=ExperimentalWarning --experimental-strip-types tests/bridge-contract.ts",
		"check:child": "node --disable-warning=ExperimentalWarning --experimental-strip-types tests/headless-child.ts",
		"test": "npm run check:migration && npm run check:contract && npm run check:child"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"typescript": "^5.6.0"
	}
}
