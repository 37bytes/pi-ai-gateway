{
	"name": "pi-ai-gateway",
	"version": "0.4.3-agp.11",
	"type": "module",
	"description": "AI Gateway extension for Pi model discovery, routing, and quota visibility",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/37bytes/pi-ai-gateway.git"
	},
	"files": [
		"index.ts",
		"src",
		"README.md",
		"scripts/omp-prod",
		"scripts/omp-test",
		"scripts/omp-profile-launch.sh"
	],
	"pi": {
		"extensions": [
			"./"
		]
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"ai-gateway"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"check:migration": "bun scripts/run-isolated.ts scripts/check-config-migration.ts",
		"check:contract": "bun scripts/run-isolated.ts tests/bridge-contract.ts",
		"check:models": "bun scripts/run-isolated.ts tests/model-contract.ts",
		"check:installed-host": "bun tests/installed-host-contract.ts",
		"check:quota": "bun scripts/run-isolated.ts tests/quota-freshness.ts",
		"check:child": "bun scripts/run-isolated.ts tests/headless-child.ts",
		"check:register-all": "bun scripts/run-isolated.ts tests/register-all.ts",
		"check:discovery-cache": "bun scripts/run-isolated.ts tests/discovery-cache-recovery.ts",
		"check:profile-layout": "bun scripts/run-isolated.ts tests/profile-layout.ts",
		"check:profile-namespace": "bun scripts/run-isolated.ts tests/profile-namespace.ts",
		"check:profile-binding": "bun scripts/run-isolated.ts tests/profile-binding.ts",
		"check:profile-isolation": "bun scripts/run-isolated.ts tests/profile-isolation.ts",
		"check:child-inheritance": "bun scripts/run-isolated.ts tests/child-inheritance.ts",
		"check:api-family-override": "bun scripts/run-isolated.ts tests/api-family-override.ts",
		"check:runtime-separation": "bun scripts/run-isolated.ts tests/runtime-separation.ts",
		"check:legacy-resume": "bun scripts/run-isolated.ts tests/legacy-resume.ts",
		"check:fail-closed": "bun scripts/run-isolated.ts tests/fail-closed.ts",
		"test": "npm run check:migration && npm run check:contract && npm run check:models && npm run check:quota && npm run check:child && npm run check:discovery-cache && npm run check:register-all && npm run check:profile-layout && npm run check:profile-namespace && npm run check:profile-binding && npm run check:profile-isolation && npm run check:child-inheritance && npm run check:api-family-override && npm run check:runtime-separation && npm run check:legacy-resume && npm run check:fail-closed"
	},
	"dependencies": {
		"@oh-my-pi/pi-catalog": "18.2.0"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-ai": "18.2.0",
		"@oh-my-pi/pi-coding-agent": "18.2.0",
		"@oh-my-pi/pi-tui": "18.2.0"
	},
	"devDependencies": {
		"typescript": "^5.6.0"
	}
}
